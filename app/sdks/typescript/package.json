{
  "name": "@public-map/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript SDK for the PUBLIC-MAP public REST API (/api/v1).",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "@types/node": "^20"
  }
}
