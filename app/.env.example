# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real secrets.

# ── Database (Neon or Supabase — either works, both give a standard
#    Postgres connection string) ────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Clerk (auth/RBAC) — create a free application at clerk.com,
#    "Next.js" quickstart gives you these two keys ──────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxx"
# clerkMiddleware()'s auth.protect() runs before any React render, so it
# can't see the ClerkProvider signInUrl/signUpUrl props — it only reads
# these env vars for the redirect target, otherwise it falls back to the
# Clerk-hosted Account Portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Anthropic (default LLM provider — see architecture plan) ────────
ANTHROPIC_API_KEY="sk-ant-xxxxxxxx"

# ── Inngest (background jobs / automation engine) — leave unset for
#    local dev, the Inngest Dev Server runs without keys; set these
#    once deploying to Vercel with a real Inngest account ───────────
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── Sentry (error monitoring) ────────────────────────────────────────
SENTRY_DSN=""

# ── Google OAuth (Business Profile + Search Console + Analytics Data
#    API — one OAuth client, one consent grant covers all three, see
#    lib/google/oauth.ts). Create an OAuth 2.0 Client ID (type "Web
#    application") in the Google Cloud project, add the redirect URI
#    below to its "Authorized redirect URIs", then paste the Client
#    ID/Secret here. Until these are set, every Google-backed module
#    (GBP, SEO's Search Console/Analytics prep) stays on its mock provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ── FastSpring (Phase 3 — billing, merchant of record, NOT Stripe) ───
#    Create a FastSpring account + storefront, then set these. Until
#    then lib/billing always uses the mock provider — see README.
FASTSPRING_API_USERNAME=""
FASTSPRING_API_PASSWORD=""
#    From the webhook's config screen in the FastSpring dashboard —
#    verifies the `X-FS-Signature` header (see lib/billing/webhook.ts).
FASTSPRING_WEBHOOK_SECRET=""

# ── E-signature (Phase 3 — DocuSign or Dropbox Sign, buy don't build) ─
#    lib/esign always uses the mock provider until one of these is wired.
ESIGN_API_KEY=""

# ── Resend (transactional email — /admin/users invitations) ──────────
#    Create an account at resend.com, verify the sending domain (or a
#    subdomain of it), then create an API key. Until this is set,
#    lib/email/resend.ts always no-ops: an invitation still gets created
#    and still activates normally, it just isn't emailed automatically —
#    see lib/email/invitation.ts.
RESEND_API_KEY=""
#    Must be on the domain verified in Resend above.
RESEND_FROM_EMAIL="PUBLIC-MAP <invitations@mail.public-map.com>"

# ── n8n automations (Phase 3) ─────────────────────────────────────────
#    Outbound: URL n8n exposes for a "Webhook" trigger node — leave unset
#    to just log dispatched events (see /admin/integrations) without sending.
N8N_WEBHOOK_URL=""
#    Inbound: shared secret n8n sends as `Authorization: Bearer <secret>`
#    when calling POST /api/webhooks/n8n. Required — that route always
#    rejects requests while this is unset.
N8N_INBOUND_SECRET=""

# ── Universal integrations/webhooks (lib/integrations/, /admin/integrations)
#    Vendor-agnostic outbound webhooks + inbound API keys — not specific to
#    n8n, works with any HTTPS endpoint. Required before creating any API
#    key or webhook endpoint; both throw a clear "not configured" error
#    until set. Generate locally with:
#      node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_SECRET_ENCRYPTION_KEY="" # base64-encoded 32 random bytes
INTEGRATION_API_KEY_PEPPER="" # long random string — treat as a secret, never reuse the encryption key's value

# ── Vercel Cron (Phase 3 — scheduled report delivery, see vercel.json) ─
#    Vercel sets this automatically for its own Cron Jobs once deployed;
#    only needed locally if you want to simulate a signed cron request.
CRON_SECRET=""

# ── PUBLIC-MAP Audit — SEPARATE Supabase project (see db/audit-schema.ts) ──
#    Deliberately distinct variable names from DATABASE_URL/NEXT_PUBLIC_*
#    above: this MUST be a different Supabase project than the main site's,
#    never the same connection string. db/guard-main-production.ts refuses
#    to boot (and every audit:db:* script refuses to run) if this points at
#    the main production database or duplicates DATABASE_URL exactly.
#
#    Where to get these — Supabase dashboard, "PUBLIC-MAP Audit" project:
#    - AUDIT_DATABASE_URL: Project Settings → Database → Connection string
#      (URI, "Session pooler" or "Transaction pooler" — copy as-is, not the
#      direct connection, same pattern as the main project's DATABASE_URL).
#    - NEXT_PUBLIC_AUDIT_SUPABASE_URL / _ANON_KEY: Project Settings → API.
#      The anon key is safe to expose to the browser, but this app never
#      queries Supabase directly from client code — signed URLs are always
#      minted server-side (see lib/gbp-audit/storage.ts). Kept here for
#      completeness, not currently required for anything to work.
#    - AUDIT_SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role.
#      SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_, never send to the
#      browser, never log it. Used only to create signed URLs for private
#      Storage buckets and for admin-only bucket management.
AUDIT_DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
NEXT_PUBLIC_AUDIT_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_AUDIT_SUPABASE_ANON_KEY="eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AUDIT_SUPABASE_SERVICE_ROLE_KEY="eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
