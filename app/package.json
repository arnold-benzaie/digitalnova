    "framer-motion": "^12.43.0",
    "google-auth-library": "10.5.0",
    "googleapis": "^173.0.0",
    "js-yaml": "^4.3.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
