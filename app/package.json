    "preview-schema:apply": "tsx scripts/preview-schema-apply.mjs",
    "collections:generate": "tsx scripts/generate-client-collections.mjs",
    "templates:n8n:generate": "tsx scripts/generate-n8n-templates.mjs",
    "templates:make:generate": "tsx scripts/generate-make-scenarios.mjs",
    "templates:airtable:generate": "tsx scripts/generate-airtable-scripts.mjs",
    "test:e2e": "playwright test",
    "test:approval": "tsx --test --experimental-test-module-mocks lib/actions/user-approval.test.mjs",
    "test:integrations": "tsx --test --test-concurrency=1 --experimental-test-module-mocks lib/integrations/foundations.test.mjs lib/integrations/webhook-system.integration.test.mjs lib/integrations/webhook-endpoint-management.integration.test.mjs lib/api-v1/auth.integration.test.mjs lib/api-v1/audits.integration.test.mjs lib/api-v1/clients.integration.test.mjs lib/api-v1/tasks-interactions.integration.test.mjs lib/api-v1/billing-plan.integration.test.mjs lib/api-v1/rate-limit.integration.test.mjs lib/developer-console/actions.integration.test.mjs lib/developer-console/queries.integration.test.mjs lib/developer-console/dev-tools.integration.test.mjs lib/developer-console/webhooks-actions.integration.test.mjs",
    "test:approval:e2e": "playwright test --config=playwright.approval.config.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
