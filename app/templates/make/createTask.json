{
  "name": "PUBLIC-MAP — Create a staff to-do tied to a client",
  "flow": [
    {
      "id": 1,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": false,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://app.public-map.com/api/v1/tasks",
        "serializeUrl": false,
        "method": "post",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer YOUR_PUBLIC_MAP_API_KEY"
          },
          {
            "name": "Idempotency-Key",
            "value": "REPLACE_WITH_A_UNIQUE_VALUE_PER_RUN"
          }
        ],
        "qs": [],
