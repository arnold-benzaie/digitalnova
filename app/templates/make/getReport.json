{
  "name": "PUBLIC-MAP — Get a single audit report, with every issue",
  "flow": [
    {
      "id": 1,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": false,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://app.public-map.com/api/v1/reports/YOUR_ID",
        "serializeUrl": false,
        "method": "get",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer YOUR_PUBLIC_MAP_API_KEY"
          }
        ],
        "qs": [],
        "bodyType": "empty",
        "parseResponse": true,
        "followRedirect": false
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {}
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}
